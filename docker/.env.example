# Copy this file to `.env` in this same docker/ directory and adjust the values as
# needed:
#   cp docker/.env.example docker/.env
#
# docker compose automatically loads docker/.env when running commands with
# `docker compose -f docker/docker-compose.yml ...` from the project root, and
# substitutes these variables into the `command:` list of each service below.
#
# Every variable has a matching fallback default in docker-compose.yml, so deleting
# a line (or the whole file) just falls back to that default instead of failing.

# ── desktop profile → main.py ───────────────────────────────────────────────
# Live step-by-step RRT, then continuous RRT* optimization.
RRT_MAP_NAME=smile.png
RRT_STEER_DELTA=15
RRT_GOAL_RADIUS=10
RRT_MAX_NODES=50000
RRT_X_INIT=40
RRT_Y_INIT=40
RRT_X_GOAL=700
RRT_Y_GOAL=550
RRT_MAX_PLANNING_TIME=30
# RRT* tuning knobs (nearest-neighbor gain, radius cap, and legacy unused radius)
RRT_GAMMA_RRT=1000
RRT_ETA_RRT=20
RRT_NEAR_RADIUS=20

# ── plan-then-draw profile → plan_then_draw.py ──────────────────────────────
# RRT and RRT* each plan fully first, then the finished tree and path are drawn.
PLAN_THEN_DRAW_MAP_NAME=smile.png
PLAN_THEN_DRAW_STEER_DELTA=15
PLAN_THEN_DRAW_GOAL_RADIUS=10
PLAN_THEN_DRAW_MAX_NODES=20000
PLAN_THEN_DRAW_X_INIT=30
PLAN_THEN_DRAW_Y_INIT=30
PLAN_THEN_DRAW_X_GOAL=30
PLAN_THEN_DRAW_Y_GOAL=460
PLAN_THEN_DRAW_MAX_PLANNING_TIME=15
# RRT* tuning knobs (nearest-neighbor gain, radius cap, and legacy unused radius)
PLAN_THEN_DRAW_GAMMA_RRT=1000
PLAN_THEN_DRAW_ETA_RRT=20
PLAN_THEN_DRAW_NEAR_RADIUS=50

# ── differential-drive profile → main_differential_drive.py ────────────────
# Plans for a DifferentialDriveRobot ([x, y, theta] state) instead of a point robot.
# RRT plans fully first, then RRT* does, each drawing its tree/path and then
# animating the robot along the found path.
DIFF_DRIVE_MAP_NAME=smile.png
DIFF_DRIVE_GOAL_RADIUS=20
DIFF_DRIVE_MAX_NODES=20000
DIFF_DRIVE_X_INIT=30
DIFF_DRIVE_Y_INIT=30
DIFF_DRIVE_X_GOAL=30
DIFF_DRIVE_Y_GOAL=460
DIFF_DRIVE_MAX_PLANNING_TIME=20
# Circular footprint radius, used both for collision checking and to draw the robot.
DIFF_DRIVE_ROBOT_RADIUS=8
# Bounds for the randomly sampled [linear_velocity, angular_velocity] control
# (linear velocity's lower bound is always 0; angular velocity's is -DIFF_DRIVE_ANGULAR_VELOCITY_MAX).
DIFF_DRIVE_LINEAR_VELOCITY_MAX=20
DIFF_DRIVE_ANGULAR_VELOCITY_MAX=1
# steer_delta is set to this value internally, and DifferentialDriveSteering uses it
# directly as the per-extension drive distance in pixels — keep it well above 1.0.
DIFF_DRIVE_SAMPLING_TIME=20.0
# States of the final path drawn per second when animating the robot.
DIFF_DRIVE_FPS=10
