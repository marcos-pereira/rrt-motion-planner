# Copy this file to `.env` in this same docker/ directory and adjust the values as
# needed:
#   cp docker/.env.example docker/.env
#
# docker compose automatically loads docker/.env when running commands with
# `docker compose -f docker/docker-compose.yml ...` from the project root, and
# substitutes these variables into the `command:` list of each service below.
#
# Every variable has a matching fallback default in docker-compose.yml, so deleting
# a line (or the whole file) just falls back to that default instead of failing.

# ── desktop profile → main.py ───────────────────────────────────────────────
# Live step-by-step RRT, then continuous RRT* optimization.
RRT_MAP_NAME=smile.png
RRT_STEER_DELTA=15
RRT_GOAL_RADIUS=10
RRT_MAX_NODES=50000
RRT_X_INIT=40
RRT_Y_INIT=40
RRT_X_GOAL=700
RRT_Y_GOAL=550
RRT_MAX_PLANNING_TIME=30
# RRT* tuning knobs (nearest-neighbor gain, radius cap, and legacy unused radius)
RRT_GAMMA_RRT=1000
RRT_ETA_RRT=20
RRT_NEAR_RADIUS=20

# ── plan-then-draw profile → plan_then_draw.py ──────────────────────────────
# RRT and RRT* each plan fully first, then the finished tree and path are drawn.
PLAN_THEN_DRAW_MAP_NAME=smile.png
PLAN_THEN_DRAW_STEER_DELTA=15
PLAN_THEN_DRAW_GOAL_RADIUS=10
PLAN_THEN_DRAW_MAX_NODES=20000
PLAN_THEN_DRAW_X_INIT=30
PLAN_THEN_DRAW_Y_INIT=30
PLAN_THEN_DRAW_X_GOAL=30
PLAN_THEN_DRAW_Y_GOAL=460
PLAN_THEN_DRAW_MAX_PLANNING_TIME=15
# RRT* tuning knobs (nearest-neighbor gain, radius cap, and legacy unused radius)
PLAN_THEN_DRAW_GAMMA_RRT=1000
PLAN_THEN_DRAW_ETA_RRT=20
PLAN_THEN_DRAW_NEAR_RADIUS=50
